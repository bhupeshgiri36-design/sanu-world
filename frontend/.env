# Add public environment variables here
# VITE_API_URL=http://localhost:3000

# --- Adsterra ad zone snippets ---
# All zones below are live/Active in the Adsterra dashboard for
# sanu-world.onrender.com. Provider tag is fixed to 'adsterra' since every
# slot uses the same network.

# Top banner (728x90) — also reused for Bottom banner below.
VITE_TOP_AD_SNIPPET=<script>	atOptions = {		'key' : '3f57501d3a5d1ef837e30f46f2b2e58b',		'format' : 'iframe',		'height' : 90,		'width' : 728,		'params' : {}	}; </script> <script src="https://www.highrevenueformat.com/3f57501d3a5d1ef837e30f46f2b2e58b/invoke.js"></script>
VITE_TOP_AD_PROVIDER=adsterra

# Side banner (160x600 skyscraper)
VITE_SIDE_AD_SNIPPET=<script>	atOptions = {		'key' : 'f27d2e892e059a04f49bd3801b36d574',		'format' : 'iframe',		'height' : 600,		'width' : 160,		'params' : {}	}; </script> <script src="https://www.highrevenueformat.com/f27d2e892e059a04f49bd3801b36d574/invoke.js"></script>
VITE_SIDE_AD_PROVIDER=adsterra

# Bottom banner — reuses the same 728x90 zone as Top (same code, two spots).
VITE_BOTTOM_AD_SNIPPET=<script>	atOptions = {		'key' : '3f57501d3a5d1ef837e30f46f2b2e58b',		'format' : 'iframe',		'height' : 90,		'width' : 728,		'params' : {}	}; </script> <script src="https://www.highrevenueformat.com/3f57501d3a5d1ef837e30f46f2b2e58b/invoke.js"></script>
VITE_BOTTOM_AD_PROVIDER=adsterra

# Native Banner — content-blending format, rendered on JoinRoom page.
VITE_NATIVE_AD_SNIPPET=<script async="async" data-cfasync="false" src="https://pl30999912.profitableratecpmnetwork.com/825f9d8998e2e6eca19d7db03f0cd9f6/invoke.js"></script><div id="container-825f9d8998e2e6eca19d7db03f0cd9f6"></div>
VITE_NATIVE_AD_PROVIDER=adsterra

# Popunder — INTENTIONALLY NOT WIRED UP IN THE APP. This format hijacks
# the very next click/tap ANYWHERE on the page (including inside form
# fields) to force a redirect/new-tab-open — that's what was causing the
# "typing in Join Room sends me to another page" bug. Left here only so
# the key isn't lost; do not import/mount this globally without scoping
# it to a single explicit button click, or the same bug comes back.
VITE_POPUNDER_SNIPPET=<script src="https://pl30999914.profitableratecpmnetwork.com/bd/48/53/bd485304f84bdf4bdae543b2e8a710f4.js"></script>

# Social Bar — site-wide, injected right before </body> (see index.html).
VITE_SOCIAL_BAR_SNIPPET=<script src="https://pl30999911.profitableratecpmnetwork.com/f8/26/52/f82652127adc24b0d4c707c06d242ef6.js"></script>

# --- Adsterra Direct Link (Smartlink) ---
# CPC product — paid the moment someone clicks it, regardless of what they
# do after. Rendered as its own honest "Sponsored" link on Landing.jsx and
# Goodbye.jsx, never silently paired with the real Telegram button.
VITE_ADSTERRA_DIRECT_LINK=https://www.profitableratecpmnetwork.com/bm27ta2x?key=04cae6bf43b670043e86c55a67636338
