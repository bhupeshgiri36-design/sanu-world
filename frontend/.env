# --- Adsterra Direct Link (Smartlink) ---
# CPC product — paid the moment someone clicks it, regardless of what they
# do after. Rendered as its own honest "Sponsored" link on Landing.jsx and
# Goodbye.jsx, never silently paired with the real Telegram button.
VITE_ADSTERRA_DIRECT_LINK=https://www.profitableratecpmnetwork.com/bm27ta2x?key=04cae6bf43b670043e86c55a67636338

